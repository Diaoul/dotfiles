#!/usr/bin/env bash

PLUGIN_DIR="$CONFIG_DIR/plugins"

# theme
source "$CONFIG_DIR/colors.sh"

# No bar background at all: the widgets are opaque overlay pills, so they float
# directly on the wallpaper. corner_radius and blur_radius only shape a fill that
# no longer exists, and a border would outline empty space.
bar=(
  position=top
  height=36
  margin=16
  y_offset=8
  blur_radius=0
  color="$TRANSPARENT"
  border_width=0
)
sketchybar --bar "${bar[@]}"

# A pill's size comes from its content insets, not from the background itself:
# icon.padding_left and label.padding_right are its outer edges, and
# icon.padding_right + label.padding_left is the gap between glyph and text.
# padding_left/right sit outside the pill and space the widgets apart.
default=(
  padding_left=5
  padding_right=5
  icon.font="CaskaydiaCove Nerd Font:Bold:17.0"
  icon.color="$ROSE"
  icon.padding_left=11
  icon.padding_right=5
  label.font="CaskaydiaCove Nerd Font:Bold:17.0"
  label.color="$WHITE"
  label.padding_left=5
  label.padding_right=11
  background.color="$OVERLAY"
  background.corner_radius=6
  background.height=28
  background.drawing=off
)
sketchybar --default "${default[@]}"

# load items
source "$CONFIG_DIR/items/workspaces.sh"
# Right-hand items are laid out right-to-left in the order they are added, so
# this reads as the reverse of what you see: datetime anchors the right edge and
# media ends up leftmost. Each widget carries its own overlay pill.
source "$CONFIG_DIR/items/datetime.sh"
source "$CONFIG_DIR/items/volume.sh"
source "$CONFIG_DIR/items/battery.sh"
source "$CONFIG_DIR/items/network.sh"
source "$CONFIG_DIR/items/slack.sh"
source "$CONFIG_DIR/items/media.sh"
# Last, so it sits at the left edge of the right-hand cluster, and hidden until
# yubikey-touch-detector.sh says the key is waiting for a touch.
source "$CONFIG_DIR/items/yubikey.sh"

# reload the bar by itself whenever a file under CONFIG_DIR changes
sketchybar --hotload true

sketchybar --update
