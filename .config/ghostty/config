font-family = Monospace
font-size = 13

# cursive italics; on Linux fontconfig already sets this on the resolved family
font-feature = ss01
theme = Rose Pine
window-padding-x = 8
window-padding-y = 6
confirm-close-surface = false
shell-integration = fish
window-decoration = true
macos-titlebar-style = hidden
gtk-titlebar = false
resize-overlay = never
font-thicken = true

# send Alt instead of composing characters, so alt+<key> bindings reach the shell
macos-option-as-alt = true
