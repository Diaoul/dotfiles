#!/bin/bash

options=(
  style=round
  width=3.0
  hidpi=on
  # undocumented (missing from the man page): draws the border over the window
  # edge so the native macOS outline stops showing as a second border
  order=above
  active_color=0xffebbcba
  inactive_color=0xff414550
)

borders "${options[@]}"
